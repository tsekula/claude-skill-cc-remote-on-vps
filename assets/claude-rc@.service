# Templated systemd --user unit: one instance per Remote Control server.
#
#   systemctl --user enable --now claude-rc@sandbox
#
# The instance name (%i) is BOTH the served directory under ~/projects AND the
# session name shown in claude.ai/code and the mobile Code tab. Keep it to
# [a-z0-9-]. Run `claude` once in ~/projects/<name> to accept the workspace
# trust dialog before enabling, or the service will fail to start.

[Unit]
Description=Claude Code Remote Control (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/%i
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=TERM=dumb
Environment=NO_COLOR=1
ExecStart=/usr/local/bin/claude remote-control --name %i
Restart=on-failure
RestartSec=10
# The live status line redraws once a second; discard it. Recover the session
# URL from claude.ai/code, or `claude remote-control --continue` in the dir.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
